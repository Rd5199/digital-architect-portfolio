# ─────────────────────────────────────────────────────────────
#  Free AI Audit — configuration
#  Copy this file to `.env` (local) and set the same vars in your
#  Vercel project (Settings → Environment Variables) for production.
#  Nothing audit-related is hardcoded in the source — it all lives here.
# ─────────────────────────────────────────────────────────────

# ── Backend (serverless function) ───────────────────────────
# Required: your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional backend tuning (defaults shown):
# AUDIT_MODEL=claude-haiku-4-5         # swap to claude-sonnet-4-6 / claude-opus-4-8 for deeper analysis
# AUDIT_MAX_TOKENS=1500
# AUDIT_FETCH_TIMEOUT_MS=5000          # how long to wait when reading the prospect's site
# AUDIT_TEXT_LIMIT=4000                # chars of page text sent to the model
# AUDIT_FINDING_COUNT=3                # bottlenecks + prescriptions to return
# AUDIT_USER_AGENT=Mozilla/5.0 (compatible; DigitalArchitect-AI-Audit/1.0)
# AUDIT_SYSTEM_PROMPT=                 # full prompt override (advanced; leave blank for the built-in default)

# ── Frontend (Vite — must be prefixed with VITE_) ───────────
# Scheduler link for the "Book my free deep-dive" CTA. Leave blank to scroll to the contact form.
VITE_BOOKING_URL=

# Web3Forms access key for capturing audit leads by email. Leave blank to skip lead capture.
VITE_WEB3FORMS_KEY=

# Optional frontend tuning (defaults shown):
# VITE_AUDIT_ENDPOINT=/api/audit
# VITE_AUDIT_STAGE_MS=850              # dwell time per scanning stage
